ANTHROPIC_API_KEY=
MINIMAX_API_KEY=
# Opcional: China mainland → https://api.minimaxi.com/anthropic
# MINIMAX_BASE_URL=https://api.minimax.io/anthropic
QUILLAMI_MODEL=sonnet
QUILLAMI_EVAL_MODEL=haiku
# alias: auto, sonnet, sonnet-4.5, opus, fable, haiku, minimax
# auto = Jev elige Haiku/Sonnet/Opus por turno (solo Anthropic)

TYPESAFE_API_KEY=
# QUILLAMI_JEV=0   # apaga Jev aunque haya TYPESAFE_API_KEY
# o el ID completo: claude-sonnet-5, MiniMax-M3

# También puedes poner estas variables en ~/.quillami/.env
# para usar `quillami` desde cualquier carpeta.
# Si falta una key, el CLI te la pide (oculta) y la guarda ahí.
# Compat: QUILLAMI_* y KILLAMI_* (legacy); ~/.killami/.env sigue cargándose.
