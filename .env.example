OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
QUILLAMI_MODEL=auto
QUILLAMI_EVAL_MODEL=haiku
# alias: auto, sonnet, sonnet-4.5, opus, fable, haiku, openrouter
# auto = Jev elige el modelo por turno (Anthropic u OpenRouter; necesita TYPESAFE_API_KEY)
# OpenRouter: cualquier id vendor/modelo, p. ej. QUILLAMI_MODEL=openai/gpt-5.6-sol
# o el ID completo de Claude: claude-sonnet-5
# OPENROUTER_BASE_URL=https://openrouter.ai/api

TYPESAFE_API_KEY=
# QUILLAMI_JEV=0   # apaga Jev aunque haya TYPESAFE_API_KEY

# Opcional, gratis (https://artificialanalysis.ai/api-reference): con OpenRouter y Jev,
# auto elige entre todos los modelos de OpenRouter según benchmarks
ARTIFICIAL_ANALYSIS_API_KEY=
# QUILLAMI_AUTO_VENDORS=anthropic,openai,google   # limita auto a esos proveedores

# También puedes poner estas variables en ~/.quillami/.env
# para usar `quillami` desde cualquier carpeta.
# Si falta una key, el CLI te la pide (oculta) y la guarda ahí.
# Compat: QUILLAMI_* y KILLAMI_* (legacy); ~/.killami/.env sigue cargándose.

EASYBITS_API_KEY=
# MCP: ~/.quillami/mcp.json — Authorization: Bearer ${EASYBITS_API_KEY}
