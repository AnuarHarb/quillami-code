{
  "name": "quillami-code",
  "version": "0.3.0",
  "description": "Quillami Code — agente de código en la terminal, nacido en el Caribe colombiano.",
  "author": "Anuar Harb",
  "license": "MIT",
  "type": "module",
  "bin": {
    "quillami": "./dist/index.js",
    "quillami-code": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnuarHarb/killa-code.git"
  },
  "homepage": "https://github.com/AnuarHarb/killa-code#readme",
  "bugs": {
    "url": "https://github.com/AnuarHarb/killa-code/issues"
  },
  "keywords": [
    "cli",
    "coding-agent",
    "agent",
    "anthropic",
    "quillami",
    "caribe",
    "colombia"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "eval": "tsx evals/run.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
